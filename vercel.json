{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://semantic-document-research.onrender.com/"
    },
    {
      "source": "/api/",
      "destination": "https://semantic-document-research.onrender.com/"
    },
    {
      "source": "/api/:path*",
      "destination": "https://semantic-document-research.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
